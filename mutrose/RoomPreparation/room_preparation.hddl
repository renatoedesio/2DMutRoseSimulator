(define (domain hospital)
    (:types room - object
            MoveRobot CleanerRobot - robot)
    (:predicates
        (clean ?rm - room)
        (sanitized ?r - robot)
        (prepared ?rm - room)
        (door-open ?rm - room)
        (door-operational ?rm - room)
        (accessible ?rm - room)
        (alternate-access ?rm - room)
        (standard-cleaning-available ?rm - room)
        (backup-cleaning-available ?rm - room)
        (standard-organization-available ?rm - room)
        (alternative-organization-available ?rm - room)
    )
    (:capabilities moveobject cleaning sanitize door-opening)

    (:task RoomCleaning :parameters (?r - CleanerRobot ?rm - room))
    (:method room-cleaning-door-open
        :parameters (?r - CleanerRobot ?rm - room)
        :task (RoomCleaning ?r ?rm)
        :precondition (and
            (door-open ?rm)    
            (standard-cleaning-available ?rm)
        )
        :ordered-subtasks (and
            (clean-room ?r ?rm)
        )
    )
    (:method room-cleaning-door-closed
        :parameters (?r - CleanerRobot ?rm - room)
        :task (RoomCleaning ?r ?rm)
        :precondition (and
            (not (door-open ?rm))
            (door-operational ?rm)
            (standard-cleaning-available ?rm)
        )
        :subtasks (and
            (a1 (open-door ?r ?rm))
            (a2 (clean-room ?r ?rm))
        )
        :ordering (and
            (a1 < a2)
        )
    )

    (:method room-cleaning-backup-service
        :parameters (?r - CleanerRobot ?rm - room)
        :task (RoomCleaning ?r ?rm)
        :precondition (and
            (door-open ?rm)
            (not (standard-cleaning-available ?rm))
            (backup-cleaning-available ?rm)
        )
        :ordered-subtasks (and (clean-room-backup ?r ?rm))
    )

    (:method room-cleaning-alternate-access
        :parameters (?r - CleanerRobot ?rm - room)
        :task (RoomCleaning ?r ?rm)
        :precondition (and
            (not (door-open ?rm))
            (not (door-operational ?rm))
            (alternate-access ?rm)
        )
        :ordered-subtasks (and
            (clean-room-alternative ?r ?rm)
        )
    )

    (:action clean-room
        :parameters (?r - CleanerRobot ?rm - room)
        :required-capabilities (cleaning)
        :precondition (and
            (not (clean ?rm))
        )
        :effect (and
            (clean ?rm)
            (not (sanitized ?r))
        )
    )
    (:action open-door
        :parameters (?r - CleanerRobot ?rm - room)
        :required-capabilities (door-opening)
        :precondition (and
            (not (door-open ?rm))
        )
        :effect (and
            (door-open ?rm)
        )
    )

    (:action clean-room-alternative
        :parameters (?r - CleanerRobot ?rm - room)
        :required-capabilities (cleaning)
        :precondition (and
            (not (clean ?rm))
            (alternate-access ?rm)
        )
        :effect (and
            (clean ?rm)
            (not (sanitized ?r))
        )
    )

    (:action clean-room-backup
        :parameters (?r - CleanerRobot ?rm - room)
        :required-capabilities (cleaning)
        :precondition (and (not (clean ?rm)) (backup-cleaning-available ?rm))
        :effect (and (clean ?rm) (not (sanitized ?r)))
    )

    (:task FurnitureMoving :parameters (?rt - robotteam ?rm - room))
    (:method furniture-moving
        :parameters (?rt - robotteam ?rm - room)
        :task (FurnitureMoving ?rt ?rm)
        :precondition (and (standard-organization-available ?rm))
        :ordered-subtasks (and
            (move-furniture ?rt ?rm)
        )
    )

    (:method furniture-moving-alternative
        :parameters (?rt - robotteam ?rm - room)
        :task (FurnitureMoving ?rt ?rm)
        :precondition (and
            (not (standard-organization-available ?rm))
            (alternative-organization-available ?rm)
        )
        :ordered-subtasks (and (move-furniture-alternative ?rt ?rm))
    )

    (:action move-furniture
        :parameters (?rt - robotteam ?rm - room)
        :required-capabilities (moveobject)
        :precondition ()
        :effect (and
            (prepared ?rm)
        )
    )

    (:action move-furniture-alternative
        :parameters (?rt - robotteam ?rm - room)
        :required-capabilities (moveobject)
        :precondition (and (alternative-organization-available ?rm))
        :effect (and (prepared ?rm))
    )

    (:task RobotSanitization :parameters (?r - CleanerRobot ?srm - room))
    (:method robot-sanitization
        :parameters (?r - CleanerRobot ?srm - room)
        :task (RobotSanitization ?r ?srm)
        :precondition ()
        :ordered-subtasks (and
            (sanitize-robot ?r ?srm)
        )
    )

    (:action sanitize-robot
        :parameters (?r - CleanerRobot ?srm - room)
        :required-capabilities (sanitize)
        :precondition (and
            (not (sanitized ?r))
        )
        :effect (and
            (sanitized ?r)
        )
    )
)
